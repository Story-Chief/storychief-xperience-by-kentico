<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <!-- Keep this at the oldest Xperience version supported by the package. -->
    <KenticoXperienceVersion Condition="'$(KenticoXperienceVersion)' == ''">31.7.4</KenticoXperienceVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Kentico.Xperience.Admin" Version="$(KenticoXperienceVersion)" />
    <PackageVersion Include="Kentico.Xperience.Core" Version="$(KenticoXperienceVersion)" />
    <PackageVersion Include="Kentico.Xperience.WebApp" Version="$(KenticoXperienceVersion)" />
    <PackageVersion Include="kentico.xperience.azurestorage" Version="$(KenticoXperienceVersion)" />
    <PackageVersion Include="kentico.xperience.imageprocessing" Version="$(KenticoXperienceVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>
</Project>
